{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiosk Naplata Karata",
  "version": "1.0.6",
  "identifier": "rs.muzejmilenemaric.kiosk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Muzej Mileve Maric",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "focus": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/webtunel/mileva-maric-naplata/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzQjg0N0M5NThGMUFGMzgKUldRNHIvRll5VWU0d3hicEUrdWpTdnE5YzRZTzBnT3VwUHBIYWg1U3puenhzTFV0M29UUy9vTEQK"
    }
  }
}
